# ==========================================
# NeuroScope-3D - Git Ignore Rules
# ==========================================

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
*.lnk

# Environment Variables & Secrets (CRITICAL)
.env
.env.*
!.env.example
secrets/
*.pem
*.key
credentials.json

# Python Virtual Environments & Packages
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
!frontend/src/lib/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Node.js / Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
dist/
dist-ssr/
*.local

# Medical Data & Large Scans (STRICT ZERO-LEAKAGE)
# Never commit patient or research MRI data to GitHub
data/
datasets/
raw_data/
uploads/
*.nii
*.nii.gz
*.dcm
*.dicom
*.mha
*.mhd
*.h5
*.hdf5
*.npz

# Model Weights, Binaries & Large Checkpoints
models/checkpoints/
weights/
*.pth
*.pt
*.onnx
*.bin
*.ckpt
*.safetensors
*.engine
*.tflite

# Output Predictions & Generated Reports
outputs/
runs/
predictions/
reports/generated/
*.pdf
logs/
*.log

# IDE & Editor Settings
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
